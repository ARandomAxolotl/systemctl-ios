#!/bin/zsh

BLACK=$'\033[30m'
RED=$'\033[31m'
GREEN=$'\033[32m'
YELLOW=$'\033[33m'
BLUE=$'\033[34m'
MAGENTA=$'\033[35m'
CYAN=$'\033[36m'
WHITE=$'\033[37m'

BRIGHT_BLACK=$'\033[90m'
BRIGHT_RED=$'\033[91m'
BRIGHT_GREEN=$'\033[92m'
BRIGHT_YELLOW=$'\033[93m'
BRIGHT_BLUE=$'\033[94m'
BRIGHT_MAGENTA=$'\033[95m'
BRIGHT_CYAN=$'\033[96m'
BRIGHT_WHITE=$'\033[97m'

BOLD=$'\033[1m'
UNDERLINE=$'\033[4m'

RESET=$'\033[0m'

err(){
  printf '%s\n' "$RED$*$RESET"
}

log(){
  printf '%s\n' "$CYAN$*$RESET"
}

success() {
    printf '%s%s%s\n' "$GREEN" "$*" "$RESET"
}

warn() {
    printf '%s%s%s\n' "$YELLOW" "$*" "$RESET"
}

echo(){
  printf '%s\n' "$*"
}

HelpEcho(){
  printf '%-20s : %s\n' "$1" "$2"
}

ChkStatus() {
    local Unit="$1"

    local output
    output=$(launchctl print "$Domain$Unit" 2>&1)

    if (( $? != 0 )); then
        err "✗ $unit"
        printf '  %s\n' "$output"
        return 1
    fi

    local state
    state=$(printf '%s\n' "$output" | awk -F' = ' '/^[[:space:]]*state = / {print $2; exit}')

    case "$state" in
        running)
            printf '%s●%s %s%s%s\n' \
                "$BRIGHT_GREEN" "$RESET" "$BOLD" "$unit" "$RESET"
            printf '  State: %s%s%s\n' "$GREEN" "$state" "$RESET"
            ;;
        *)
            printf '%s●%s %s%s%s\n' \
                "$BRIGHT_YELLOW" "$RESET" "$BOLD" "$unit" "$RESET"
            printf '  State: %s%s%s\n' "$YELLOW" "$state" "$RESET"
            ;;
    esac
}

ShowHelp() {
  echo "systemctl COMMAND ..."
  HelpEcho "status [service]" "Show status of [service]."
}

StartSvc() {
  log "Starting $2"
  launchctl kickstart -k "$Domain$2"
  if [[ $? != 0 ]]; then
    err "Failed to start $2."
  else
    success "Started $2."
  fi
}

if [[ $(uname -s) = "Linux" ]]; then
  err "Bro this is Linux. Use native systemctl or what the hell your distro give you."
  exit 1
fi

if [[ $(id -G) != 0 ]]; then
  err "no root :("
  exit 1
fi

Domain="user/$(id -u)/"

case "$1" in
  status)
    ChkStatus "$2"
    ;;
  "")
    ShowHelp
    exit
    ;;
  start)
    StartSvc "$2"
    ;;
  *)
    err "Idk what command is $UNDERLINE$BOLD$1$RESET${RED}."
    ShowHelp
    exit 1
    ;;
esac

